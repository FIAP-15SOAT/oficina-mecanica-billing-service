generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Outbox ───────────────────────────────────────────────────────────────────

model OutboxMessage {
  id           BigInt   @id @default(autoincrement())
  messageId    String   @unique @default(uuid()) @map("message_id") @db.Uuid
  type         String   @db.VarChar(64)
  workOrderId  String?  @map("work_order_id") @db.Uuid
  payload      Json
  traceContext Json     @default("{}") @map("trace_context")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("outbox")
}
